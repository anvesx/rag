{
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.stryker.config.ts" },
  "mutate": ["src/**/*.ts", "!src/index.ts"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation.json"
  },
  "plugins": ["../../node_modules/@stryker-mutator/vitest-runner/dist/src/index.js"]
}
